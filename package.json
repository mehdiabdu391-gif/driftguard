{
  "name": "driftguard",
  "version": "0.1.0",
  "description": "Know what breaks before you bump your Stripe API version, and which lines upstream API spec changes (Stripe, OpenAI, GitHub, Twilio) break.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Mehdi Abdu Mohammed",
  "bin": {
    "drift": "bin/drift.js"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p jsconfig.json",
    "track": "node bin/drift.js track",
    "sdk-maps": "node bin/drift.js sdk-maps",
    "site": "node bin/drift.js site"
  },
  "dependencies": {
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
